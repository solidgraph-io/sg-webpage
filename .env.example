# SolidGraph Website — environment variables
# Copy this file to .env and fill in real values (NEVER commit .env).

# Public site URL (used for canonical URLs and OG tags)
PUBLIC_SITE_URL=https://solidgraph.dev

# Turborepo Remote Cache (optional — self-hosted cache server)
TURBO_TOKEN=
TURBO_TEAM=
TURBO_API=

# ── SPEC-FORM-001: Lead capture (/api/lead) ──────────────────────────────────
# Email provider for lead delivery (resend | postmark — default: resend)
LEAD_PROVIDER=resend

# Where leads arrive (required at runtime — set in Drone/Dokploy secrets)
LEAD_TO_EMAIL=

# Sender address shown in the email (must be a verified domain in Resend)
LEAD_FROM_EMAIL=leads@solidgraph.io

# Resend API key — required when LEAD_PROVIDER=resend
# Get it at https://resend.com → API Keys
RESEND_API_KEY=

# Postmark server token — required when LEAD_PROVIDER=postmark
# Get it at https://postmarkapp.com → Server → API Tokens
POSTMARK_SERVER_TOKEN=

# ── Cloudflare Turnstile (SPEC-FORM-001/RF-3) ────────────────────────────────
# TURNSTILE_SITE_KEY is embedded in the HTML at render time (not client JS).
# TURNSTILE_SECRET_KEY is server-only. Both required in production.
# Leave empty in local dev — Turnstile verification is skipped when secret key is absent.
# Get keys at https://dash.cloudflare.com → Turnstile → Add site
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
