# SolidGraph Website — environment variables
# Copy this file to .env and fill in real values (NEVER commit .env).

# Public site URL (used for canonical URLs and OG tags)
PUBLIC_SITE_URL=https://solidgraph.dev

# Turborepo Remote Cache (optional — self-hosted cache server)
TURBO_TOKEN=
TURBO_TEAM=
TURBO_API=

# ── SPEC-FORM-001: Lead capture (/api/lead) ──────────────────────────────────
# Email provider for lead delivery (resend | postmark — default: resend)
EMAIL_PROVIDER=resend

# Where leads arrive (required at runtime — set in Drone/Dokploy secrets)
EMAIL_RECIPIENT=

# Sender address shown in the email (defaults to leads@solidgraph.io)
EMAIL_FROM=leads@solidgraph.io

# Resend API key — required when EMAIL_PROVIDER=resend
# Get it at https://resend.com → API Keys
RESEND_API_KEY=

# Postmark server token — required when EMAIL_PROVIDER=postmark
# Get it at https://postmarkapp.com → Server → API Tokens
POSTMARK_SERVER_TOKEN=
