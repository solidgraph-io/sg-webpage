---
import SectionHead from './SectionHead.astro';
import Eyebrow from './Eyebrow.astro';
import FaqItem from './FaqItem.astro';

interface FaqEntry {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  lead?: string;
  items: FaqEntry[];
}

const {
  eyebrow = 'FAQ',
  heading = 'Questions We Hear All the Time',
  lead = 'No jargon. Just honest answers.',
  items,
} = Astro.props;
---

<section class="faq" id="faq" data-section="faq" aria-labelledby="faq-heading">
  <div class="container">
    <SectionHead data-reveal>
      <Eyebrow slot="eyebrow" class="centered">{eyebrow}</Eyebrow>
      <h2 id="faq-heading">{heading}</h2>
      <p>{lead}</p>
    </SectionHead>
    <div class="faq-list">
      {items.map((item) => <FaqItem question={item.question} answer={item.answer} />)}
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 130px 0;
    background: #fff;
  }
  .faq-list {
    max-width: 840px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (max-width: 720px) {
    .faq {
      padding: 80px 0;
    }
    .faq-list {
      gap: 8px;
    }
  }
</style>
