---
import { Image } from 'astro:assets';
import logoLinear from '../assets/logo_linear_primary_288h.webp';

interface Props {
  href?: string;
  class?: string;
}

const { href = '/', class: extra } = Astro.props;
const cls = ['logo', extra].filter(Boolean).join(' ');
---

<a href={href} class={cls}>
  <Image src={logoLinear} alt="SolidGraph" height={96} densities={[1, 2]} />
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
  }
  .logo img {
    /* 34px made the wordmark illegible; emitted at 96px so 2x stays sharp */
    height: 44px;
    width: auto;
  }
</style>
