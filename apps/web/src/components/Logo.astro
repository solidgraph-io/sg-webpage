---
/**
 * Logo — avatar mark + wordmark lockup.
 * Used in nav and footer. On dark surfaces parent scope can invert
 * the img (filter) and recolor .logo-text.
 */
interface Props {
  href?: string;
  class?: string;
}

const { href = '/', class: extra } = Astro.props;
const cls = ['logo', extra].filter(Boolean).join(' ');
---

<a href={href} class={cls}>
  <img src="/assets/logo_avatar.png" alt="SolidGraph" width="34" height="34" />
  <span class="logo-text">
    <b>SolidGraph</b>
    <small>SOLUTIONS</small>
  </span>
</a>

<style>
.logo { display: flex; align-items: center; gap: 11px; }
.logo img { height: 34px; width: auto; }
.logo-text { display: flex; flex-direction: column; line-height: 1; }
.logo-text b { font-weight: 700; font-size: 16px; color: var(--indigo); letter-spacing: -.02em; }
.logo-text small { font-size: 9px; letter-spacing: .26em; color: var(--ink); margin-top: 3px; font-weight: 600; }
</style>
