---
import Eyebrow from './Eyebrow.astro';
import IconBox from './IconBox.astro';

interface Pillar {
  num: string;
  iconId: string;
  title: string;
  text: string;
}

interface Lead {
  strong: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  lead: Lead;
  pillars: Pillar[];
}

const { eyebrow = 'Why SolidGraph', heading, lead, pillars } = Astro.props;
---

<section class="value" data-section="value" id="value" aria-labelledby="value-heading">
  <div class="container">
    <div class="value-head">
      <div data-reveal="left">
        <Eyebrow>{eyebrow}</Eyebrow>
        <h2 id="value-heading" set:html={heading} />
      </div>
      <div class="lead" data-reveal="right" style="--d:120ms">
        <span class="strong">{lead.strong}</span>
        {lead.body}
      </div>
    </div>
    <div class="pillars">
      {pillars.map((p, i) => (
        <div class="pillar" data-reveal style={`--d:${i * 90}ms`}>
          <span class="num">{p.num}</span>
          <IconBox size="lg" class="ic">
            <svg width="22" height="22" aria-hidden="true"><use href={p.iconId} /></svg>
          </IconBox>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.value { padding: 130px 0 110px; position: relative; overflow: hidden; }

/* ── Value head (2-col desktop, 1-col mobile) ── */
.value-head {
  display: grid; grid-template-columns: 1.05fr .95fr; gap: 70px;
  align-items: end; margin-bottom: 70px;
}
.value-head h2 { margin-top: 20px; }
.lead { color: var(--muted); font-size: 16px; line-height: 1.8; }
.strong { color: var(--ink); font-weight: 600; display: block; margin-bottom: 14px; font-size: 18px; }

/* ── Pillars grid ── */
.pillars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

/* ── Pillar card (base rules BEFORE media queries) ── */
.pillar {
  position: relative; border-radius: var(--radius-lg);
  padding: 32px 28px 30px; background: #fff;
  border: 1px solid var(--line); overflow: hidden;
  transition: transform .5s var(--ease), box-shadow .5s var(--ease);
}
.num { position: absolute; top: 22px; right: 26px; font-size: 13px; font-weight: 700; color: var(--lilac); transition: color .4s ease; }
.pillar :global(.ic) {
  margin-bottom: 24px;
  transition: background .4s ease, color .4s ease, transform .4s var(--ease-spring);
}
.pillar h3 { margin-bottom: 10px; font-size: 18px; transition: color .4s ease; }
.pillar p { color: var(--muted); font-size: 13.5px; line-height: 1.65; transition: color .4s ease; }
.pillar::before {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(165deg, var(--indigo), var(--night));
  opacity: 0; transition: opacity .5s ease; z-index: 0;
}
.pillar > * { position: relative; z-index: 1; }
.pillar:hover { transform: translateY(-8px); box-shadow: var(--shadow-md); }
.pillar:hover::before { opacity: 1; }
.pillar:hover .num { color: rgba(255,255,255,.4); }
.pillar:hover h3 { color: #fff; }
.pillar:hover p { color: rgba(255,255,255,.8); }
.pillar:hover :global(.ic) { background: rgba(255,255,255,.16); color: #fff; transform: scale(1.08) rotate(-5deg); }

/* ── Responsive overrides — AFTER base rules ── */
@media (max-width: 980px) {
  .value-head { grid-template-columns: 1fr; gap: 26px; }
  .pillars { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 540px) {
  .pillars { grid-template-columns: 1fr; }
}
</style>
