---
/**
 * HostingCard — recurring hosting tier card.
 * Ports components/hosting-card.css from design/template.
 */

interface Props {
  name: string;
  price: string;
  desc: string;
  items: string[];
  delay?: string;
}

const { name, price, desc, items, delay = '0ms' } = Astro.props;
---

<div class="hosting-card" data-reveal style={`--d:${delay}`}>
  <div class="name">{name}</div>
  <div class="price">{price}</div>
  <p class="desc">{desc}</p>
  <ul>
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .hosting-card {
    background: var(--lilac-2);
    border-radius: var(--radius);
    padding: 28px 24px;
    border: 1px solid transparent;
    transition: all 0.4s var(--ease);
  }
  .hosting-card:hover {
    background: #fff;
    border-color: var(--periwinkle);
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }
  .name {
    font-size: 13px;
    font-weight: 700;
    color: var(--indigo);
    letter-spacing: 0.03em;
  }
  .price {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-top: 6px;
  }
  .desc {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 10px;
    line-height: 1.55;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 16px;
  }
  ul li {
    font-size: 12px;
    color: var(--ink);
    padding-left: 18px;
    position: relative;
    line-height: 1.55;
    margin-bottom: 7px;
  }
  ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--periwinkle);
  }
</style>
