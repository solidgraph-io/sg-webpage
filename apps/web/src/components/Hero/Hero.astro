---
import type { HeroProps } from './Hero.types';
import styles from './Hero.module.scss';
import Aurora from '../Aurora.astro';
import Pill from '../Pill.astro';
import Button from '../Button.astro';
import FloatingCard from '../FloatingCard.astro';

type Props = HeroProps;

const { pill, title, subtitle, ctas, snippet, preview, floats } = Astro.props;
---

<section class="hero has-spot" aria-labelledby="hero-heading">
  <div class="spotlight" aria-hidden="true"></div>
  <Aurora />
  <div class="hero-grid-mesh" aria-hidden="true"></div>
  <div class={`container ${styles['hero-inner']}`}>
    {
      pill && (
        <div class={styles['hero-top']} data-reveal="scale">
          <Pill ping>{pill}</Pill>
        </div>
      )
    }
    <h1 id="hero-heading" class="display" set:html={title} />
    {
      subtitle && (
        <p class={styles['hero-sub']} data-reveal style="--d:120ms">
          {subtitle}
        </p>
      )
    }
    <div class={styles['hero-ctas']} data-reveal style="--d:200ms">
      {
        ctas.map((cta) => (
          <Button variant={cta.variant} href={cta.href} magnetic>
            <span>{cta.label}</span>
            {cta.icon && (
              <svg width="16" height="16" aria-hidden="true">
                <use href="/icons.svg#i-arrow" />
              </svg>
            )}
          </Button>
        ))
      }
    </div>
    {
      snippet && (
        <p class={styles['hero-snippet']} data-reveal style="--d:280ms">
          {snippet}
        </p>
      )
    }

    {
      preview && (
        <div class={styles['hero-stage']} data-reveal="scale" style="--d:360ms">
          {floats?.map((f) => (
            <FloatingCard variant="hero" class={f.pos}>
              <div class="ic">
                <svg width="18" height="18" aria-hidden="true">
                  <use href={f.iconId} />
                </svg>
              </div>
              <div>
                <b>{f.label}</b>
                <span>{f.sub}</span>
              </div>
            </FloatingCard>
          ))}

          <div class="hero-screen" id="heroScreen">
            <div class={styles['hs-bar']}>
              <>
                <i />
                <i />
                <i />
              </>
              <div class="url">{preview.url}</div>
            </div>
            <div class={styles['hs-body']}>
              <div class={styles['hs-left']}>
                {preview.tag && <span class="tag">{preview.tag}</span>}
                {preview.title && <p class={styles['preview-title']} set:html={preview.title} />}
                {preview.body && <p>{preview.body}</p>}
                {preview.cta && <span class="b">{preview.cta}</span>}
                {preview.chips && (
                  <div class="chips">
                    {preview.chips.map((c) => (
                      <span>{c}</span>
                    ))}
                  </div>
                )}
              </div>
              <div class={styles['hs-right']} aria-hidden="true">
                <span class="ring r1" />
                <span class="ring r2" />
                <span class="ring r3" />
                <div class="core">
                  {preview.logoSrc && (
                    <img src={preview.logoSrc} alt="SolidGraph" width="196" height="294" />
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>
