---
import type { AboutProps } from './About.types';
import { Image } from 'astro:assets';
import styles from './About.module.scss';
import logoAvatarFull from '../../assets/logo_avatar_full.png';
import Eyebrow from '../Eyebrow.astro';
import FloatingCard from '../FloatingCard.astro';
import DiffItem from '../DiffItem.astro';

type Props = AboutProps;

const {
  eyebrow = 'About Us',
  heading = "We're Developers Who Build From Scratch — Not a Template Agency",
  sub = 'SolidGraph Solutions LLC — custom website development for local businesses.',
  body,
  visual,
  diffs,
  cities,
} = Astro.props;
---

<section class="about" id="about" data-section="about" aria-labelledby="about-heading">
  <div class:list={['container', styles['about-grid']]}>
    <div class={styles['about-visual']} data-reveal="left" aria-hidden="true">
      <div class={styles.orbit}></div>
      <div class:list={[styles.orbit, styles.o2]}></div>
      <div class={styles['center-logo']}>
        <Image src={logoAvatarFull} alt="" aria-hidden="true" loading="lazy" width={200} />
      </div>
      {
        visual.badges.map((b) => (
          <FloatingCard variant="badge" class={b.pos}>
            <div class="ic">
              <svg width="18" height="18" aria-hidden="true">
                <use href={b.iconId} />
              </svg>
            </div>
            <div>
              <>
                <b>{b.title}</b>
                <span>{b.subtitle}</span>
              </>
            </div>
          </FloatingCard>
        ))
      }
    </div>

    <div data-reveal="right">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 id="about-heading" style="margin-top:18px;">{heading}</h2>
      <p class={styles['about-sub']}>{sub}</p>
      <div class={styles['about-body']}>
        {body.map((p) => <p>{p}</p>)}
      </div>
      <div class={styles['diff-list']}>
        {diffs.map((d) => <DiffItem iconId={d.iconId} title={d.title} text={d.text} />)}
      </div>
      <div class={styles['about-cities']}>
        <div class={styles.h}>Proudly Serving</div>
        <div class={styles.cities}>
          {
            cities.map((c) => (
              <div class={styles.city}>
                <>
                  <b>{c.name}</b>
                  <span>{c.note}</span>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
