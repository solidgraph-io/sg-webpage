---
import type { ContactProps } from './Contact.types';
import styles from './Contact.module.scss';
import Eyebrow from '../Eyebrow.astro';
import Button from '../Button.astro';
import FormField from '../FormField.astro';

type Props = ContactProps;

const {
  eyebrow = 'Contact',
  heading,
  leads,
  altHeading = 'Prefer a direct conversation?',
  altRows,
  submitLabel = 'Send My Request',
  privacyNote = 'We never share your information. No spam, ever.',
  successMsg = "Thank you! We'll reach out within 24 business hours.",
  formAction = '/api/lead',
  contactState,
  turnstileSiteKey = '',
} = Astro.props;
---

<section class="contact" id="contact" data-section="contact" aria-labelledby="contact-heading">
  <div class:list={['container', styles['contact-grid']]}>
    <div class={styles['contact-left']} data-reveal="left">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 id="contact-heading">{heading}</h2>
      {leads.map((p) => <p class={styles.lead}>{p}</p>)}
      <div class="contact-alt">
        <h3>{altHeading}</h3>
        {
          altRows.map((row) => (
            <div class="row">
              <div class="ic" aria-hidden="true">
                <svg width="14" height="14" aria-hidden="true">
                  <use href={row.iconId} />
                </svg>
              </div>
              <div>
                <>
                  <b>{row.label}</b>
                  <span>{row.sub}</span>
                </>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <form class="contact-form" data-reveal="right" action={formAction} method="post">
      <div class={styles['field-grid']}>
        <FormField label="First Name" fieldId="first_name" required>
          <input id="first_name" type="text" name="first_name" required />
        </FormField>
        <FormField label="Last Name" fieldId="last_name" required>
          <input id="last_name" type="text" name="last_name" required />
        </FormField>
        <FormField label="Email Address" fieldId="email" required>
          <input id="email" type="email" name="email" required />
        </FormField>
        <FormField label="Phone Number" fieldId="phone">
          <input id="phone" type="tel" name="phone" />
        </FormField>
        <FormField label="Business Name" fieldId="business_name" required>
          <input id="business_name" type="text" name="business_name" required />
        </FormField>
        <FormField label="City" fieldId="city" required>
          <select id="city" name="city" required>
            <option value="">Select your city...</option>
            <option>Charlotte, NC</option>
            <option>Springfield, MO</option>
            <option>Branson, MO</option>
            <option>Other</option>
          </select>
        </FormField>
        <FormField label="Which plan are you interested in?" fieldId="plan_interest" full>
          <select id="plan_interest" name="plan_interest">
            <option>Not sure yet</option>
            <option>Nano — $1,300</option>
            <option>Micro — $2,800</option>
            <option>Pro — $5,500</option>
            <option>Enterprise — Custom</option>
            <option>Just hosting</option>
          </select>
        </FormField>
        <FormField label="Tell us a little about your business" fieldId="message" full>
          <textarea
            id="message"
            name="message"
            placeholder="What do you do, who are your customers, and what do you hope your website does for you?"
          ></textarea>
        </FormField>
      </div>
      {/* honeypot — bots fill it; humans never see it */}
      <div
        style="position:absolute;left:-9999px;top:-9999px;overflow:hidden;width:1px;height:1px"
        aria-hidden="true"
      >
        <label for="_gotcha">Leave this field empty</label>
        <input type="text" name="_gotcha" id="_gotcha" tabindex="-1" autocomplete="off" />
      </div>
      {
        turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" />
        )
      }
      <div class={styles['form-foot']}>
        <span class={styles.privacy}>{privacyNote}</span>
        <Button type="submit" magnetic>
          <span>{submitLabel}</span>
          <svg width="16" height="16" aria-hidden="true"><use href="/icons.svg#i-arrow"></use></svg>
        </Button>
      </div>
      <div
        class={styles['success-msg']}
        id="successMsg"
        tabindex="-1"
        style={contactState === 'success' ? 'display:block' : undefined}
      >
        {successMsg}
      </div>
    </form>
  </div>
</section>

<script>
  import '../../scripts/contact-form';
</script>
{
  turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}
