---
/**
 * Plans — pricing plans + hosting sub-block (SEC-007).
 * Ports 07-plans.html section layout; delegates cards to PlanCard/HostingCard.
 */
import SectionHead from './SectionHead.astro';
import Eyebrow from './Eyebrow.astro';
import PlanCard from './PlanCard.astro';
import HostingCard from './HostingCard.astro';

interface PlanItem {
  name: string; tagline: string; price: string; priceNote: string;
  delivery: string; bestFor: string; includes: string[];
  excludes?: string[]; ctaLabel: string; ctaHref: string; popular?: boolean;
}

interface HostingItem { name: string; price: string; desc: string; items: string[]; }

interface Props {
  heading?: string;
  subheading?: string;
  note?: string;
  plans: PlanItem[];
  hosting: { heading: string; subheading?: string; cards: HostingItem[] };
}

const {
  heading = 'Simple Plans. No Hidden Fees.',
  subheading = 'Pick the plan that fits where your business is right now. You can always grow into a bigger one.',
  note = 'Every plan is custom-built from scratch. No templates, no page builders, no Wix. You own 100% of the code.',
  plans,
  hosting,
} = Astro.props;
---

<section class="plans" id="plans" data-section="plans" aria-labelledby="plans-heading">
  <div class="container">
    <SectionHead data-reveal>
      <Eyebrow slot="eyebrow" class="centered">Pricing</Eyebrow>
      <h2 id="plans-heading">{heading}</h2>
      <p>{subheading}</p>
    </SectionHead>

    <div class="note-bar" data-reveal>
      <svg width="16" height="16" style="color:var(--periwinkle)" aria-hidden="true"><use href="/icons.svg#i-spark"/></svg>
      {note}
    </div>

    <div class="plan-grid">
      {plans.map((plan, i) => (
        <PlanCard {...plan} delay={`${i * 90}ms`} />
      ))}
    </div>

    <div class="hosting">
      <div class="hosting-head" data-reveal>
        <h3>{hosting.heading}</h3>
        {hosting.subheading && <p>{hosting.subheading}</p>}
      </div>
      <div class="hosting-grid">
        {hosting.cards.map((card, i) => (
          <HostingCard {...card} delay={`${i * 80}ms`} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
/* ── Section ── */
.plans { padding: 130px 0 110px; background: #fff; position: relative; }

/* ── Note bar ── */
.note-bar {
  max-width: 720px; margin: 0 auto 56px; text-align: center;
  background: var(--lilac); padding: 15px 26px; border-radius: 999px;
  font-size: 13px; color: var(--indigo); font-weight: 500;
  display: flex; align-items: center; justify-content: center; gap: 10px;
}

/* ── Plan grid (base rules BEFORE media queries) ── */
.plan-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; align-items: stretch; }

/* ── Hosting ── */
.hosting { margin-top: 84px; }
.hosting-head { text-align: center; max-width: 640px; margin: 0 auto 40px; }
.hosting-head h3 { font-size: 28px; font-weight: 800; letter-spacing: -.02em; margin-bottom: 10px; }
.hosting-head p { color: var(--muted); font-size: 15px; }
.hosting-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

/* ── Responsive (AFTER base rules) ── */
@media (max-width: 1100px) {
  .plan-grid { grid-template-columns: 1fr 1fr; }
  .plan-grid :global(.plan.popular) { transform: none; }
  .plan-grid :global(.plan.popular:hover) { transform: translateY(-8px); }
}
@media (max-width: 980px) { .hosting-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px) { .plan-grid { grid-template-columns: 1fr; } }
@media (max-width: 540px) { .hosting-grid { grid-template-columns: 1fr; } }
</style>
