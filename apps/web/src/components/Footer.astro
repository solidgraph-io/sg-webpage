---
import { Image } from 'astro:assets';
import logoAvatar from '../assets/logo_avatar.png';

interface FootCol { heading: string; links: { label: string; href: string }[] }

interface Props {
  brandLink?: string;
  tagline?: string;
  locations?: string[];
  cols?: FootCol[];
  copyright?: string;
}

const {
  brandLink = 'https://solidgraph.dev',
  tagline = 'Custom-built websites for local businesses.',
  locations = ['Charlotte, NC', 'Springfield-Branson, MO'],
  cols = [
    { heading: 'Navigate', links: [
      { label: 'How It Works', href: '#how-it-works' },
      { label: 'Our Plans',    href: '#plans' },
      { label: 'Our Work',     href: '#portfolio' },
      { label: 'About',        href: '#about' },
      { label: 'FAQ',          href: '#faq' },
      { label: 'Contact',      href: '#contact' },
    ]},
    { heading: 'Plans', links: [
      { label: 'Nano — $1,300',  href: '#plans' },
      { label: 'Micro — $2,800', href: '#plans' },
      { label: 'Pro — $5,500',   href: '#plans' },
      { label: 'Enterprise',      href: '#plans' },
      { label: 'Hosting Plans',   href: '#plans' },
    ]},
    { heading: 'Get in Touch', links: [
      { label: 'hello@solidgraph.com', href: 'mailto:hello@solidgraph.com' },
      { label: 'Free Quote',           href: '#contact' },
      { label: 'Discovery Call',       href: '#contact' },
    ]},
  ],
  copyright = '© 2026 SolidGraph Solutions LLC. All rights reserved.',
} = Astro.props;
---

<footer data-section="footer">
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href={brandLink} class="logo" rel="noopener">
          <Image src={logoAvatar} alt="SolidGraph" style="height:40px;width:auto; filter: brightness(0) invert(1);" loading="lazy" />
          <span class="logo-text"><b>SolidGraph</b><small>SOLUTIONS</small></span>
        </a>
        <p>{tagline}</p>
        <div class="locs">
          {locations.map((loc) => <span>{loc}</span>)}
        </div>
      </div>
      {cols.map((col) => (
        <div class="foot-col">
          <h5>{col.heading}</h5>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="foot-bottom">
      <span>{copyright}</span>
      <div class="legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
      </div>
    </div>
  </div>
  <div class="foot-big" aria-hidden="true">SolidGraph</div>
</footer>

<style>
footer { background: var(--night-2); color: #fff; padding: 80px 0 32px; position: relative; overflow: hidden; }
.foot-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 44px; padding-bottom: 54px; border-bottom: 1px solid rgba(255,255,255,.1); position: relative; z-index: 2; }
.foot-brand { display: flex; flex-direction: column; gap: 20px; max-width: 290px; }
.foot-brand :global(.logo-text) b { color: #fff; }
.foot-brand :global(.logo-text) small { color: rgba(255,255,255,.6); }
.foot-brand p { font-size: 13px; color: rgba(255,255,255,.62); line-height: 1.6; }
.locs { display: flex; flex-wrap: wrap; gap: 8px; }
.locs span { font-size: 11px; color: #fff; background: rgba(255,255,255,.08); padding: 6px 13px; border-radius: 999px; }
.foot-col h5 { color: #fff; font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; margin-bottom: 20px; }
.foot-col ul { display: flex; flex-direction: column; gap: 11px; }
.foot-col ul li a { font-size: 13.5px; color: rgba(255,255,255,.7); transition: color .2s ease, padding-left .2s ease; }
.foot-col ul li a:hover { color: #fff; padding-left: 4px; }
.foot-bottom { padding-top: 30px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 14px; font-size: 12px; color: rgba(255,255,255,.5); position: relative; z-index: 2; }
.legal { display: flex; gap: 18px; }
.legal a { color: rgba(255,255,255,.5); }
.legal a:hover { color: #fff; }
.foot-big { position: absolute; bottom: -3%; left: 0; right: 0; text-align: center; font-size: 20vw; font-weight: 800; color: rgba(255,255,255,.025); letter-spacing: -.04em; pointer-events: none; line-height: 1; z-index: 1; white-space: nowrap; }
@media (max-width: 880px) { .foot-grid { grid-template-columns: 1fr 1fr; gap: 32px; } .foot-brand { grid-column: 1 / -1; } }
</style>
