---
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import FormField from './FormField.astro';

interface AltRow { iconId: string; label: string; sub: string; }

interface Props {
  eyebrow?: string;
  heading: string;
  leads: string[];
  altHeading?: string;
  altRows: AltRow[];
  submitLabel?: string;
  privacyNote?: string;
  successMsg?: string;
  formAction?: string;
  contactState?: string;
}

const {
  eyebrow = 'Contact',
  heading,
  leads,
  altHeading = 'Prefer a direct conversation?',
  altRows,
  submitLabel = 'Send My Request',
  privacyNote = 'We never share your information. No spam, ever.',
  successMsg = 'Thank you! We\'ll reach out within 24 business hours.',
  formAction = '/api/lead',
  contactState,
} = Astro.props;
---

<section class="contact" id="contact" data-section="contact" aria-labelledby="contact-heading">
  <div class="container contact-grid">
    <div class="contact-left" data-reveal="left">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 id="contact-heading">{heading}</h2>
      {leads.map((p) => <p class="lead">{p}</p>)}
      <div class="contact-alt">
        <h4>{altHeading}</h4>
        {altRows.map((row) => (
          <div class="row">
            <div class="ic" aria-hidden="true">
              <svg width="14" height="14" aria-hidden="true"><use href={row.iconId} /></svg>
            </div>
            <div><b>{row.label}</b><span>{row.sub}</span></div>
          </div>
        ))}
      </div>
    </div>
    <form class="contact-form" data-reveal="right" action={formAction} method="post">
      <div class="field-grid">
        <FormField label="First Name" fieldId="first_name" required>
          <input id="first_name" type="text" name="first_name" required />
        </FormField>
        <FormField label="Last Name" fieldId="last_name" required>
          <input id="last_name" type="text" name="last_name" required />
        </FormField>
        <FormField label="Email Address" fieldId="email" required>
          <input id="email" type="email" name="email" required />
        </FormField>
        <FormField label="Phone Number" fieldId="phone">
          <input id="phone" type="tel" name="phone" />
        </FormField>
        <FormField label="Business Name" fieldId="business_name" required>
          <input id="business_name" type="text" name="business_name" required />
        </FormField>
        <FormField label="City" fieldId="city" required>
          <select id="city" name="city" required>
            <option value="">Select your city...</option>
            <option>Charlotte, NC</option>
            <option>Springfield, MO</option>
            <option>Branson, MO</option>
            <option>Other</option>
          </select>
        </FormField>
        <FormField label="Which plan are you interested in?" fieldId="plan_interest" full>
          <select id="plan_interest" name="plan_interest">
            <option>Not sure yet</option>
            <option>Nano — $1,300</option>
            <option>Micro — $2,800</option>
            <option>Pro — $5,500</option>
            <option>Enterprise — Custom</option>
            <option>Just hosting</option>
          </select>
        </FormField>
        <FormField label="Tell us a little about your business" fieldId="message" full>
          <textarea id="message" name="message" placeholder="What do you do, who are your customers, and what do you hope your website does for you?"></textarea>
        </FormField>
      </div>
      {/* honeypot — bots fill it; humans never see it */}
      <div style="position:absolute;left:-9999px;top:-9999px;overflow:hidden;width:1px;height:1px" aria-hidden="true">
        <label for="_gotcha">Leave this field empty</label>
        <input type="text" name="_gotcha" id="_gotcha" tabindex="-1" autocomplete="off" />
      </div>
      <div class="form-foot">
        <span class="privacy">{privacyNote}</span>
        <Button type="submit" magnetic>
          <span>{submitLabel}</span>
          <svg width="16" height="16" aria-hidden="true"><use href="/icons.svg#i-arrow" /></svg>
        </Button>
      </div>
      <div class="success-msg" id="successMsg" tabindex="-1"
        style={contactState === 'success' ? 'display:block' : undefined}>
        {successMsg}
      </div>
    </form>
  </div>
</section>

<script>import '../scripts/contact-form';</script>

<style>
.contact { padding: 130px 0 100px; background: #fff; }
.contact-grid { display: grid; grid-template-columns: 1fr 1.35fr; gap: 64px; align-items: start; }
.contact h2 { margin: 18px 0 0; }
.contact .lead { color: var(--muted); font-size: 15px; line-height: 1.75; margin-top: 18px; }
.contact-alt { margin-top: 38px; background: var(--lilac-2); border-radius: var(--radius); padding: 26px 28px; }
.contact-alt h4 { font-size: 14px; font-weight: 600; margin-bottom: 16px; }
.contact-alt .row { display: flex; align-items: center; gap: 13px; margin-bottom: 12px; }
.contact-alt .row .ic { width: 36px; height: 36px; border-radius: 10px; background: var(--indigo); color: #fff; display: grid; place-items: center; flex-shrink: 0; }
.contact-alt .row b { color: var(--ink); font-size: 13.5px; font-weight: 600; display: block; }
.contact-alt .row span { color: var(--muted); font-size: 12px; }
.contact-form { background: var(--lilac-2); border-radius: var(--radius-lg); padding: 40px; border: 1px solid rgba(45,61,138,.05); }
.field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.contact-form :global(input), .contact-form :global(select), .contact-form :global(textarea) { border: 1px solid var(--line); background: #fff; padding: 13px 15px; border-radius: 12px; font-family: inherit; font-size: 13.5px; color: var(--ink); transition: border-color .25s ease, box-shadow .25s ease; width: 100%; box-sizing: border-box; }
.contact-form :global(input:focus), .contact-form :global(select:focus), .contact-form :global(textarea:focus) { outline: none; border-color: var(--indigo); box-shadow: 0 0 0 4px rgba(45,61,138,.1); }
.contact-form :global(textarea) { resize: vertical; min-height: 110px; }
.form-foot { margin-top: 24px; display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap; }
.form-foot .privacy { font-size: 11.5px; color: var(--muted); }
.success-msg { display: none; margin-top: 22px; background: rgba(52,211,154,.1); color: #1a8c63; padding: 15px 18px; border-radius: 12px; font-size: 13.5px; font-weight: 500; }
:global(.field-error) { font-size: 11.5px; color: #c0392b; margin-top: 4px; }
@media (max-width: 880px) { .contact-grid { grid-template-columns: 1fr; } .field-grid { grid-template-columns: 1fr; } }
</style>
