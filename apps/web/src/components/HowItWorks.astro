---
import Aurora from './Aurora.astro';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';

interface Step {
  num: string;
  title: string;
  dur: string;
  text: string;
}

interface Cta {
  label: string;
  href: string;
  variant: 'white' | 'ghost-light';
  icon?: boolean;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  lead?: string;
  steps: Step[];
  ctas: Cta[];
}

const {
  eyebrow = 'Our Process',
  heading = 'How It Works',
  lead = 'From first conversation to live website — a simple, 4-step process.',
  steps,
  ctas,
} = Astro.props;
---

<section
  class="how has-spot"
  id="how-it-works"
  data-section="how-it-works"
  aria-labelledby="how-heading"
>
  <div class="spotlight" aria-hidden="true"></div>
  <Aurora />
  <div class="container how-grid">
    <div class="how-sticky" data-reveal="left">
      <Eyebrow class="eyebrow-how">{eyebrow}</Eyebrow>
      <h2 id="how-heading">{heading}</h2>
      <p>{lead}</p>
      <div class="how-progress" aria-hidden="true">
        {steps.map((_, i) => <i class:list={[i === 0 && 'on']} />)}
      </div>
      <div class="how-ctas">
        {
          ctas.map((cta) => (
            <Button variant={cta.variant} href={cta.href} magnetic>
              <span>{cta.label}</span>
              {cta.icon && (
                <svg width="16" height="16" aria-hidden="true">
                  <use href="/icons.svg#i-arrow" />
                </svg>
              )}
            </Button>
          ))
        }
      </div>
    </div>
    <div class="steps">
      {
        steps.map((s, i) => (
          <div class="step" data-reveal="right" style={`--d:${i * 90}ms`}>
            <span class="num">{s.num}</span>
            <div class="meat">
              <h4>
                {s.title} <span class="dur">{s.dur}</span>
              </h4>
              <p>{s.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .how {
    background: var(--night);
    color: #fff;
    padding: 130px 0;
    position: relative;
    overflow: hidden;
  }
  .how :global(.aurora) b {
    opacity: 0.35;
  }

  /* ── Grid ── */
  .how-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 70px;
    align-items: start;
    position: relative;
    z-index: 2;
  }
  .how-sticky {
    position: sticky;
    top: 120px;
  }
  .how-sticky :global(.eyebrow-how) {
    color: var(--peri-bright);
  }
  .how-sticky :global(.eyebrow-how)::before {
    background: var(--peri-bright);
  }
  .how h2 {
    color: #fff;
    margin: 20px 0 16px;
  }
  .how-sticky > p {
    color: var(--muted-d);
    font-size: 16px;
    line-height: 1.7;
    max-width: 38ch;
  }

  /* ── Progress + CTAs ── */
  .how-progress {
    margin-top: 36px;
    display: flex;
    gap: 8px;
  }
  .how-progress i {
    height: 4px;
    flex: 1;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }
  .how-progress i.on {
    background: var(--peri-bright);
  }
  .how-ctas {
    margin-top: 38px;
    display: flex;
    gap: 14px;
  }

  /* ── Step cards (base rules BEFORE media queries) ── */
  .steps {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 26px;
    padding: 30px 32px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(6px);
    transition:
      transform 0.5s var(--ease),
      background 0.4s ease,
      border-color 0.4s ease;
  }
  .step:hover {
    transform: translateY(-4px) scale(1.01);
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(125, 142, 240, 0.4);
  }
  .step .num {
    font-size: 46px;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(180deg, var(--peri-bright), rgba(125, 142, 240, 0.3));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: -0.04em;
  }
  .step .meat h4 {
    font-size: 19px;
    color: #fff;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .step .meat .dur {
    font-size: 11px;
    color: #fff;
    background: rgba(92, 112, 214, 0.55);
    padding: 4px 12px;
    border-radius: 999px;
    font-weight: 600;
  }
  .step .meat p {
    font-size: 13.5px;
    color: var(--muted-d);
    margin-top: 8px;
    line-height: 1.6;
  }

  /* ── Responsive overrides — AFTER base rules ── */
  @media (max-width: 980px) {
    .how-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .how-sticky {
      position: static;
    }
  }
</style>
