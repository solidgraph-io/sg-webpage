---
/**
 * SectionHead — centered heading block: eyebrow + h2 + lead paragraph.
 * Accepts all content via slots (eyebrow, default for h2 + p).
 */
interface Props {
  class?: string;
}

const { class: extra } = Astro.props;
const cls = ['section-head', extra].filter(Boolean).join(' ');
---

<div class={cls}>
  <slot name="eyebrow" />
  <slot />
</div>

<style>
.section-head { max-width: 760px; margin: 0 auto 64px; text-align: center; }
.section-head :global(h2) { margin: 18px 0 16px; }
.section-head :global(p) { color: var(--muted); font-size: 17px; }
</style>
