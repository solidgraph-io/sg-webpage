---
/**
 * PortfolioCard — thumbnail + meta block for portfolio items.
 * Ports components/portfolio-card.css from design/template.
 */

interface Props {
  category: string;
  title: string;
  location?: string;
  description: string;
  tag?: string;
  thumbBg: string;
  thumbInner: string;
  delay?: string;
}

const {
  category,
  title,
  location,
  description,
  tag,
  thumbBg,
  thumbInner,
  delay = '0ms',
} = Astro.props;
---

<article class="p-card" data-reveal style={`--d:${delay}`}>
  <div class="p-thumb" style={`background:${thumbBg}`}>
    {tag && <span class="p-tag">{tag}</span>}
    <svg viewBox="0 0 200 150" aria-hidden="true" set:html={thumbInner} />
  </div>
  <div class="p-meat">
    <div class="cat">{category}</div>
    <h3>{title}</h3>
    {
      location && (
        <div class="loc">
          <svg width="13" height="13" aria-hidden="true">
            <use href="/icons.svg#i-pin" />
          </svg>
          {location}
        </div>
      )
    }
    <p>{description}</p>
  </div>
</article>

<style>
  .p-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--line);
    background: #fff;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  .p-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-md);
  }
  .p-thumb {
    aspect-ratio: 4/3;
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
  }
  .p-thumb svg {
    width: 66%;
    height: 66%;
    transition: transform 0.6s var(--ease);
  }
  .p-card:hover .p-thumb svg {
    transform: scale(1.06);
  }
  .p-tag {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(255, 255, 255, 0.95);
    color: var(--indigo);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 6px 13px;
    border-radius: 999px;
  }
  .p-meat {
    padding: 26px 28px 28px;
  }
  .cat {
    font-size: 11px;
    color: var(--periwinkle);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .p-meat h3 {
    font-size: 19px;
    margin-bottom: 8px;
  }
  .loc {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .loc svg {
    color: var(--periwinkle);
  }
  .p-meat p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
  }
</style>
