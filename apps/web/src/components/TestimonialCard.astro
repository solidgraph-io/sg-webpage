---
/**
 * TestimonialCard — stars + quote + author lockup with initials avatar.
 * Ports components/testimonial-card.css from design/template.
 */

interface Props {
  quote: string;
  authorName: string;
  authorRole: string;
  initials: string;
  delay?: string;
}

const { quote, authorName, authorRole, initials, delay = '0ms' } = Astro.props;
---

<div class="t-card" data-reveal style={`--d:${delay}`}>
  <div class="stars" role="img" aria-label="5 out of 5 stars">
    {[1, 2, 3, 4, 5].map(() => <span aria-hidden="true">★</span>)}
  </div>
  <p class="quote">"{quote}"</p>
  <div class="t-author">
    <div class="avatar" aria-hidden="true">{initials}</div>
    <div>
      <b>{authorName}</b>
      <span>{authorRole}</span>
    </div>
  </div>
</div>

<style>
  .t-card {
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 34px 30px;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(45, 61, 138, 0.04);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  .t-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
  }
  .stars {
    display: flex;
    gap: 3px;
    margin-bottom: 18px;
  }
  .stars span {
    color: var(--star);
    font-size: 15px;
  }
  .quote {
    font-size: 14.5px;
    color: var(--ink);
    line-height: 1.7;
    margin-bottom: 24px;
    flex: 1;
    font-weight: 450;
  }
  .t-author {
    display: flex;
    gap: 13px;
    align-items: center;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--indigo), var(--peri-bright));
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 15px;
    flex-shrink: 0;
  }
  .t-author b {
    font-size: 14px;
    color: var(--ink);
    display: block;
    font-weight: 600;
  }
  .t-author span {
    font-size: 12px;
    color: var(--muted);
  }
</style>
