---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { buildLocalBusinessJsonLd } from '../lib/seo';
import Analytics from '../components/Analytics.astro';
import { SITE_ENV } from 'astro:env/server';
import { isStagingNoIndex } from '../lib/site-env';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const { title, description = '', canonical, ogImage, noIndex = false } = Astro.props;

const site = await getEntry('settings', 'site');
const sd = site?.data;

const jsonLd = sd ? buildLocalBusinessJsonLd(sd) : null;
// Canonical: prop overrides, then site URL, then nothing
const resolvedCanonical = canonical ?? sd?.url ?? '';
const resolvedOgImage = ogImage ?? sd?.defaultSeo.ogImage;
// noIndex: prop OR staging (SITE_ENV runtime / legacy PUBLIC_NOINDEX build flag)
const isNoIndex = noIndex || isStagingNoIndex(SITE_ENV, import.meta.env.PUBLIC_NOINDEX);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={isNoIndex ? 'noindex, nofollow' : 'index, follow'} />
    {resolvedCanonical && <link rel="canonical" href={resolvedCanonical} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {resolvedCanonical && <meta property="og:url" content={resolvedCanonical} />}
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    {sd?.name && <meta property="og:site_name" content={sd.name} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

    <!-- JSON-LD: LocalBusiness (SPEC-SEO-001/RF-2) -->
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}

    <!-- Preload critical Poppins weights -->
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-800.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Umami analytics: same-origin, async/defer, no-op without env (SPEC-ANALYTICS-001) -->
    <Analytics />

    <!-- Progressive enhancement: add .js before first paint so reveal CSS
         activates. External (not is:inline text) so CSP's script-src can stay
         'self' with no unsafe-inline / hash (SPEC-SEC-016/INV-1) — same
         blocking, synchronous-before-first-paint timing as an inline script. -->
    <script is:inline src="/enable-js.js"></script>
  </head>
  <body>
    <!-- Skip-link: first tab stop, off-screen until focused (SPEC-A11Y-001/RF-2) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <!-- Named slots keep header/footer outside <main> for correct landmark nesting -->
    <slot name="header" />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body><!-- Interactions loaded once, deferred — does not block render -->
  <script is:inline defer src="/interactions.js"></script>
</html>
