---
import { getEntry } from 'astro:content';
import { TURNSTILE_SITE_KEY } from 'astro:env/server';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import PainPoints from '../components/PainPoints.astro';
import Value from '../components/Value.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Plans from '../components/Plans.astro';
import Testimonials from '../components/Testimonials.astro';
import Portfolio from '../components/Portfolio.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import CtaStrip from '../components/CtaStrip.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const site = await getEntry('settings', 'site');
const home = await getEntry('pages', 'home');
if (!site || !home) throw new Error('[SPEC-CONTENT-001/RF-6] Missing content: settings/site or pages/home');

const contactState = Astro.url.searchParams.get('contact') ?? undefined;
const turnstileSiteKey = TURNSTILE_SITE_KEY ?? '';

const sd = site.data;
const hd = home.data;

// Strip genuinely optional plan fields so exactOptionalPropertyTypes is satisfied
const planItems = hd.plans.items.map(({ excludes, popular, ...rest }) => ({
  ...rest,
  ...(excludes !== undefined ? { excludes } : {}),
  ...(popular !== undefined ? { popular } : {}),
}));
---

<BaseLayout
  title={hd.seo?.title ?? sd.defaultSeo.title}
  description={hd.seo?.description ?? sd.defaultSeo.description}
  canonical={hd.seo?.canonical ?? sd.url}
>
  <Nav links={hd.nav.links} cta={hd.nav.cta} slot="header" />

  <Hero
    pill={hd.hero.pill}
    title={hd.hero.title}
    subtitle={hd.hero.subtitle}
    snippet={hd.hero.snippet}
    ctas={hd.hero.ctas}
    preview={hd.hero.preview}
    floats={hd.hero.floats}
  />

  <Marquee items={hd.marquee.items} />

  <PainPoints
    heading={hd.painPoints.heading}
    intro={hd.painPoints.intro}
    items={hd.painPoints.items}
    feature={hd.painPoints.feature}
  />

  <Value
    heading={hd.value.heading}
    lead={hd.value.lead}
    pillars={hd.value.pillars}
  />

  <HowItWorks steps={hd.howItWorks.steps} ctas={hd.howItWorks.ctas} />

  <Plans plans={planItems} hosting={hd.plans.hosting} />

  <Testimonials stats={hd.testimonials.stats} items={hd.testimonials.items} />

  <Portfolio items={hd.portfolio.items} />

  <About
    visual={hd.about.visual}
    body={hd.about.body}
    diffs={hd.about.diffs}
    cities={hd.about.cities}
  />

  <Faq items={hd.faq.items} />

  <CtaStrip
    heading={hd.ctaStrip.heading}
    body={hd.ctaStrip.body}
    ctaLabel={hd.ctaStrip.ctaLabel}
    ctaHref={hd.ctaStrip.ctaHref}
  />

  <Contact
    heading={hd.contact.heading}
    leads={hd.contact.leads}
    altRows={hd.contact.altRows}
    turnstileSiteKey={turnstileSiteKey}
    {...(contactState !== undefined ? { contactState } : {})}
  />

  <Footer
    brandLink={hd.footer.brandLink}
    tagline={hd.footer.tagline}
    locations={hd.footer.locations}
    cols={hd.footer.cols}
    copyright={hd.footer.copyright}
    slot="footer"
  />
</BaseLayout>
