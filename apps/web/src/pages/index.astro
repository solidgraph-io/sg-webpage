---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import PainPoints from '../components/PainPoints.astro';
import Value from '../components/Value.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Plans from '../components/Plans.astro';
import Testimonials from '../components/Testimonials.astro';

const navLinks = [
  { label: 'How It Works', href: '#how-it-works' },
  { label: 'Our Plans',    href: '#plans' },
  { label: 'Our Work',     href: '#portfolio' },
  { label: 'About Us',     href: '#about' },
  { label: 'Contact',      href: '#contact' },
];

const heroCtas = [
  { label: 'Get a Free Quote', href: '#contact', variant: 'primary'     as const, icon: true },
  { label: 'See Our Plans',    href: '#plans',   variant: 'ghost-light' as const },
];

const heroFloats = [
  { iconId: '/icons.svg#i-zap',    label: 'Live in 2 weeks', sub: 'Not months',  pos: 'f1' as const },
  { iconId: '/icons.svg#i-shield', label: 'You own it 100%', sub: 'No lock-in',  pos: 'f2' as const },
];

const marqueeItems = [
  { label: 'Built From Scratch' },
  { label: 'No Templates' },
  { label: 'You Own Everything' },
  { label: 'Charlotte, NC' },
  { label: 'Delivered in 2 Weeks' },
  { label: 'Springfield-Branson, MO' },
  { label: 'Clear, Honest Pricing' },
  { label: 'Starting at $1,300' },
];

const painItems = [
  { iconId: '/icons.svg#i-search', text: '"My business doesn\'t show up when people search online — even though I\'ve been here for years."' },
  { iconId: '/icons.svg#i-phone-off', text: '"I\'m losing customers to competitors who just have a better-looking, faster website."' },
  { iconId: '/icons.svg#i-template', text: '"I tried building something myself on Wix, but it looks cheap and I can\'t get it to do what I need."' },
  { iconId: '/icons.svg#i-dollar', text: '"I\'ve been quoted thousands by agencies — but I have no idea what I\'d actually be paying for."' },
];
const painFeature = {
  title: "You're not alone.",
  text: 'And a custom-built website is closer and more affordable than you think.',
};

const valueLead = {
  strong: 'A custom website built for your specific business — not a template dressed up to look like one.',
  body: 'At SolidGraph Solutions, we write every line of code for your business specifically. No page builders, no generic templates, no drag-and-drop shortcuts. The result is a website that loads faster, looks sharper, and actually converts visitors into customers — and it belongs 100% to you from day one.',
};

const valuePillars = [
  { num: '01', iconId: '/icons.svg#i-code',   title: 'Built From Scratch',    text: 'Every line of code written for your business. No Wix, no templates, no shortcuts.' },
  { num: '02', iconId: '/icons.svg#i-zap',    title: 'Fast Delivery',         text: 'Most custom websites are ready in 2 weeks. Not months.' },
  { num: '03', iconId: '/icons.svg#i-dollar', title: 'Clear, Honest Pricing', text: "You know exactly what you're paying for before we start. No surprises." },
  { num: '04', iconId: '/icons.svg#i-shield', title: 'You Own Everything',    text: 'Your domain, your code, your content. No vendor lock-in, ever.' },
];

const howSteps = [
  { num: '01', title: 'We Talk',    dur: '30 minutes',          text: "You tell us about your business, your customers, and what you need. No forms, no pressure — just a real conversation. Free, no commitment." },
  { num: '02', title: 'We Plan',    dur: '1–2 days',       text: "We put together a clear proposal: what your website will include, what it will cost, and when it will be ready. You approve it before we touch anything." },
  { num: '03', title: 'We Build',   dur: '10–25 business days', text: "Our team custom-builds your website from scratch. You’ll see a preview before it goes live and have rounds of feedback to make sure everything looks, feels, and works exactly right." },
  { num: '04', title: 'You Launch', dur: 'Launch day',          text: "Your website goes live. We show you how to update it yourself, and we’re here if you ever need help. It’s your site — fully in your hands." },
];
const howCtas = [
  { label: 'Get Started', href: '#contact', variant: 'white'       as const, icon: true },
  { label: 'See Plans',   href: '#plans',   variant: 'ghost-light' as const },
];

const plans = [
  {
    name: 'Nano', tagline: 'Your first custom-built online presence',
    price: '$1,300', priceNote: 'one-time payment', delivery: 'Ready in 10–15 business days',
    bestFor: 'Freelancers, home services, solo professionals, new businesses ready for a real website',
    includes: [
      'Custom-built one-page website with up to 5 sections',
      'Home, About, Services, Gallery, and Contact',
      'Contact form (name, email, message)',
      'Your own content management panel — update text and photos yourself',
      'Mobile-friendly design', 'Basic Google visibility setup (SEO)',
      'Cloudflare security and speed protection', '2 rounds of feedback before launch',
      '15-minute video tutorial to manage your site',
    ],
    excludes: ['Online store or payments', 'Blog', 'Booking system'],
    ctaLabel: 'Get Started', ctaHref: '#contact',
  },
  {
    name: 'Micro', tagline: 'More pages, more tools, more customers — all custom built',
    price: '$2,800', priceNote: 'one-time payment', delivery: 'Ready in 18–25 business days',
    bestFor: 'Restaurants, salons, retail shops, service businesses that need more than a single page',
    includes: [
      'Up to 10 custom-built pages with their own web addresses',
      'Blog — publish news, tips, and updates yourself',
      'Google Maps location on your site',
      'Live chat widget so visitors can message you instantly',
      'Google Analytics — see how many people visit your site',
      'Up to 2 custom contact forms', 'Advanced Google visibility setup',
      '3 rounds of feedback before launch', 'Everything in Nano',
    ],
    excludes: ['Online store or payments', 'Booking system'],
    ctaLabel: 'Get Started', ctaHref: '#contact', popular: true,
  },
  {
    name: 'Pro', tagline: 'Full custom development — sell online, take bookings, grow faster',
    price: '$5,500', priceNote: 'one-time payment', delivery: 'Ready in 35–50 business days',
    bestFor: 'Retailers, service businesses that take appointments, anyone ready to sell online with a real custom store',
    includes: [
      'Unlimited pages', 'Online store — sell up to 100 products',
      'Secure online payments via Stripe (credit and debit cards)',
      'Booking and appointment system',
      'Email list signup connected to Mailchimp',
      'Full custom design built from scratch',
      'Conversion tracking — know which pages bring you customers',
      'Performance optimization — loads fast on any device',
      '4 rounds of feedback before launch', 'Everything in Micro',
    ],
    excludes: ['More than 100 products (available as add-on at $2/product)'],
    ctaLabel: 'Get Started', ctaHref: '#contact',
  },
  {
    name: 'Enterprise', tagline: 'Complex custom projects, built exactly to your specs',
    price: 'Custom', priceNote: 'after a free discovery call', delivery: 'Timeline defined in proposal',
    bestFor: 'Businesses with specific integrations, large catalogs, or complex requirements that go beyond standard plans',
    includes: [
      'Everything in Pro', 'Unlimited products',
      'Multiple languages (English + Spanish)', 'Custom system integrations',
      'Advanced business automation', 'Dedicated account manager',
      'Priority support and SLA',
    ],
    ctaLabel: "Let's Talk", ctaHref: '#contact',
  },
];

const testimonialStats = [
  { value: '2 weeks', label: 'Average delivery time' },
  { value: '$0',      label: 'Hidden fees' },
  { value: '100%',    label: 'Satisfaction on delivery' },
];

const testimonials = [
  { quote: 'I had no idea getting a professional website could be this straightforward. They explained everything in plain English and delivered exactly what they promised.', authorName: 'Maria G.', authorRole: 'Hair salon owner, Charlotte NC', initials: 'MG' },
  { quote: 'Within a month of launching our new site, we started getting calls from people who found us on Google. That never happened before.', authorName: 'James R.', authorRole: 'HVAC contractor, Springfield MO', initials: 'JR' },
  { quote: 'The pricing was clear from day one. No surprises, no upselling. Just a great website at a price that made sense for my budget.', authorName: 'Sandra L.', authorRole: 'Catering business, Charlotte NC', initials: 'SL' },
];

const hosting = {
  heading: 'Keep Your Site Running Smoothly',
  subheading: 'After launch, our hosting plans take care of everything — so you never have to worry about your website going down.',
  cards: [
    { name: 'Basic Hosting', price: '$35/mo', desc: 'Hosting, security, and peace of mind. We keep your site online and protected.', items: ['High-quality hosting', 'Cloudflare protection', 'Weekly backups', 'Uptime monitoring', 'Email support (48h response)'] },
    { name: 'Active Hosting', price: '$65/mo', desc: 'Everything in Basic, plus we handle small content updates for you.', items: ['Daily backups', '2 content updates per month', 'Email support (24h response)', 'Monthly analytics report'] },
    { name: 'Managed Hosting', price: '$120/mo', desc: 'Hands-on support, regular updates, and a monthly check-in call.', items: ['5 content updates per month', '1 small feature change per month', 'Chat + email support (12h response)', 'Monthly 30-min review call', 'Performance monitoring'] },
    { name: 'Premium Hosting', price: 'From $250/mo', desc: 'Full management, priority support, and a dedicated account manager.', items: ['Unlimited content updates', 'Up to 4h development/month', 'Priority support (4h response)', 'Monthly SEO report', 'Dedicated account manager'] },
  ],
};
---

<BaseLayout
  title="SolidGraph — Custom-Built Websites for Local Businesses"
  description="We custom-build professional websites for local businesses in Charlotte and Springfield — so more customers can find you, call you, and walk through your door."
>
  <Nav links={navLinks} cta={{ label: 'Get a Free Quote', href: '#contact' }} />

  <Hero
    pill="Custom-built from scratch · No templates, ever"
    title="Your Business Deserves a Website Built <span class='grad-text'>From Scratch</span> — Not a Template"
    subtitle="We custom-build professional websites for local businesses in Charlotte and Springfield — so more customers can find you, call you, and walk through your door."
    ctas={heroCtas}
    snippet="Custom-built from scratch · Starting at $1,300 · Delivered in 2 weeks"
    preview={{
      url:     'yourbusiness.com',
      tag:     'Hand-coded',
      title:   'Built for <b>your</b> business — line by line',
      body:    'No Wix. No page builders. A real website that loads fast and converts.',
      cta:     'Get a Free Quote',
      chips:   ['Fast', 'Custom', 'Yours'],
      logoSrc: '/assets/logo_avatar.png',
    }}
    floats={heroFloats}
  />

  <Marquee items={marqueeItems} />

  <PainPoints
    heading="Sound Familiar?"
    intro="Most local business owners come to us after running into the same walls."
    items={painItems}
    feature={painFeature}
  />

  <Value
    heading="We Build It From Scratch.<br/><span class='grad-text'>You Own It Forever.</span>"
    lead={valueLead}
    pillars={valuePillars}
  />

  <HowItWorks steps={howSteps} ctas={howCtas} />

  <Plans plans={plans} hosting={hosting} />

  <Testimonials stats={testimonialStats} items={testimonials} />
</BaseLayout>
